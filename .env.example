# ==========================================
# DIGICRAFT.STORE - CONFIGURATION VARIABLES
# ==========================================

# 1. PAYPAL INTEGRATION
# Obtenez votre Client ID sur https://developer.paypal.com/dashboard/applications
# Laissez 'test' ou 'sb' en développement pour activer le mode démo/sandbox.
NEXT_PUBLIC_PAYPAL_CLIENT_ID="VOTRE_PAYPAL_CLIENT_ID_ICI"

# 2. SITE URL & METADATA
NEXT_PUBLIC_SITE_URL="https://digicraft.store"
NEXT_PUBLIC_SUPPORT_EMAIL="contact@digicraft.store"

# 3. EMAIL AUTOMATION (OPTIONNEL POUR CONFIRMATION AUTOMATIQUE)
# Si vous souhaitez envoyer automatiquement un email avec le lien de téléchargement
# Services recommandés : Resend (resend.com), EmailJS (emailjs.com) ou SendGrid.
RESEND_API_KEY="re_123456789"
